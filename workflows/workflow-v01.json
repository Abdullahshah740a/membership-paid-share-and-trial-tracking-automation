    {
      "parameters": {
        "jsCode": "// Membership counts from GHL contacts (authoritative).\n// Paid   = 'Membership Due Collected' custom field is set (money actually collected).\n// Free   = 'Proximity Fellow Expiration Date' is in the future (active 90-day trial) AND not paid.\nconst TOKEN = 'EXAMPLE_SECRET_5525C066F5';   // GHL token (update on rotation)\nconst LOC   = 'EXAMPLE_RESOURCE_ID_5271A38AF4';\nconst PROX  = 'EXAMPLE_RESOURCE_ID_B726703DBA';   // Proximity Fellow Expiration Date\nconst DUE   = 'EXAMPLE_RESOURCE_ID_1A89D13CEB';   // Membership Due Collected\n\nlet page = 1, all = [];\nwhile (page <= 40) {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://services.leadconnectorhq.com/contacts/search',\n    headers: { 'Authorization': 'Bearer ' + TOKEN, 'Version': '2021-07-28', 'Content-Type': 'application/json' },\n    body: { locationId: LOC, page, pageLimit: 100 },\n    json: true\n  });\n  const c = (resp && resp.contacts) || [];\n  all = all.concat(c);\n  if (c.length < 100) break;\n  page++;\n  await new Promise(r => setTimeout(r, 400));   // pace requests\n}\n\nfunction cf(c){ const m={}; for (const f of (c.customFields || c.customField || [])) m[f.id]=f.value; return m; }\nfunction toISO(v){\n  if (v === undefined || v === null || v === '') return '';\n  if (typeof v === 'number' || /^\\d+$/.test(String(v))) { try { return new Date(Number(v)).toISOString().slice(0,10); } catch(e){ return ''; } }\n  return String(v).slice(0,10);\n}\n\nconst today = new Date().toISOString().slice(0,10);\nlet paid = 0, free = 0;\nfor (const c of all) {\n  const m = cf(c);\n  if (m[DUE]) { paid++; continue; }          // paid = dues collected\n  const exp = toISO(m[PROX]);\n  if (exp && exp >= today) free++;            // active 90-day free trial, not yet paid\n}\nconst total = paid + free;\nconst pct = total ? Math.round((paid / total) * 1000) / 10 : 0;\nreturn [{ json: {\n  'Snapshot Date': today,\n  'Snapshot Key': 'current',\n  'Total Members': total,\n  'Paid Members': paid,\n  'Free Members': free,\n  'Paid Conversion %': pct\n}}];"
      },
